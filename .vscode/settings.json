{
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "oxc.lint.configPath": "./vite.config.mts",
  "oxc.fmt.configPath": "./vite.config.mts",
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "sonarlint.connectedMode.project": {
    "connectionId": "gitify-app",
    "projectKey": "gitify-app_gitify"
  },
  "cSpell.words": ["codegen", "Gitify", "oxfmt", "oxlint"],
  "i18n-ally.translate.engines": ["google"],
  "i18n-ally.localesPaths": ["src/renderer/i18n", "src/renderer/i18n/locales"],
  "i18n-ally.sourceLanguage": "en",
  "i18n-ally.keystyle": "nested",
  "i18n-ally.sortKeys": true
}
