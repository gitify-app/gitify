{
  "name": "gitify",
  "version": "7.10.0",
  "private": true,
  "description": "Git notifications on your menu bar.",
  "keywords": [
    "bitbucket",
    "codeberg",
    "electron",
    "electron-menubar",
    "forgejo",
    "gitea",
    "github",
    "gitify",
    "gitlab",
    "menubar",
    "notifications",
    "taskbar",
    "tray"
  ],
  "homepage": "https://gitify.io/",
  "bugs": {
    "url": "https://github.com/gitify-app/gitify/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Adam Setch",
    "url": "https://github.com/setchy"
  },
  "contributors": [
    {
      "name": "Emmanouil Konstantinidis",
      "url": "https://github.com/manosim"
    },
    {
      "name": "Jake 'Sid' Smith",
      "url": "https://github.com/JakeSidSmith"
    },
    {
      "name": "Adam Setch",
      "url": "https://github.com/setchy"
    },
    {
      "name": "Afonso Ramos",
      "url": "https://github.com/afonsojramos"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gitify-app/gitify.git"
  },
  "main": "build/main.js",
  "scripts": {
    "clean": "rimraf build coverage dist node_modules",
    "prepare": "husky",
    "build": "vp build",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "pnpm codegen --watch",
    "dev": "concurrently --names \"vite,codegen\" --prefix-colors \"blue,magenta\" \"vp dev\" \"pnpm codegen:watch\"",
    "devtools": "concurrently --names \"dev,devtools\" --prefix-colors \"cyan,green\" \"pnpm dev\" \"react-devtools\"",
    "start": "pnpm build && pnpm dev",
    "package:linux": "electron-builder --linux",
    "package:macos": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "i18n:extract": "i18next-cli extract --sync-all",
    "i18n:check": "concurrently --kill-others-on-fail --names \"sync,values,defaults\" --prefix-colors \"yellow,green,cyan\" \"pnpm i18n:check:sync\" \"pnpm i18n:check:values\" \"pnpm i18n:check:defaults\"",
    "i18n:check:sync": "i18next-cli extract --ci --quiet",
    "i18n:check:values": "node ./scripts/check-en-locales.mjs",
    "i18n:check:defaults": "node ./scripts/check-t-defaults.mjs",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "lint": "vp lint --fix",
    "lint:check": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test --coverage --run --project 'happy-dom [preload, renderer]' --project 'node [main, shared]'",
    "test:watch": "vp test --watch --coverage",
    "test:ui": "vp test --ui",
    "test:visual": "scripts/visual.sh",
    "test:visual:update": "scripts/visual.sh --update"
  },
  "dependencies": {
    "cn": "0.5.0",
    "electron-log": "5.4.4",
    "electron-menubar": "11.1.2",
    "electron-updater": "6.8.11",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.15",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@discordapp/twemoji": "16.0.1",
    "@electron/notarize": "3.1.2",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/schema-ast": "6.1.1",
    "@graphql-codegen/typed-document-node": "7.2.0",
    "@graphql-codegen/typescript-operations": "6.2.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@legendapp/list": "3.7.0",
    "@octokit/core": "7.0.8",
    "@octokit/graphql": "9.0.5",
    "@octokit/oauth-methods": "6.0.5",
    "@octokit/openapi-types": "29.0.1",
    "@octokit/plugin-paginate-rest": "16.0.0",
    "@octokit/plugin-rest-endpoint-methods": "18.0.0",
    "@octokit/request": "10.0.16",
    "@octokit/request-error": "7.1.2",
    "@octokit/types": "18.0.0",
    "@parcel/watcher": "2.6.0",
    "@primer/css": "22.3.2",
    "@primer/octicons-react": "19.42.0",
    "@primer/primitives": "11.10.0",
    "@primer/react": "38.43.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router-dom": "5.3.3",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "10.0.6",
    "date-fns": "4.4.0",
    "dotenv": "18.0.9",
    "electron": "catalog:",
    "electron-builder": "26.18.0",
    "final-form": "5.0.1",
    "graphql": "17.0.2",
    "graphql-config": "6.0.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "i18next-cli": "1.74.1",
    "playwright": "1.64.1",
    "react-devtools": "8.0.0",
    "rimraf": "6.1.3",
    "semver": "7.8.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plugin-checker": "0.14.5",
    "vite-plugin-electron": "1.1.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zustand": "5.0.16"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
